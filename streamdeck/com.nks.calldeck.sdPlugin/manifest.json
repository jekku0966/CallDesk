{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "Actions": [
        {
            "UUID": "com.nks.calldeck.answer",
            "Name": "Answer",
            "Icon": "imgs/answer-action",
            "Tooltip": "Answer the current Discord call",
            "Controllers": [
                "Keypad"
            ],
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/answer",
                    "ShowTitle": false
                }
            ],
            "UserTitleEnabled": false
        },
        {
            "UUID": "com.nks.calldeck.decline",
            "Name": "Decline",
            "Icon": "imgs/decline-action",
            "Tooltip": "Decline the current Discord call",
            "Controllers": [
                "Keypad"
            ],
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/decline",
                    "ShowTitle": false
                }
            ],
            "UserTitleEnabled": false
        },
        {
            "UUID": "com.nks.calldeck.hangup",
            "Name": "Hang Up",
            "Icon": "imgs/hangup-action",
            "Tooltip": "Hang Up the current Discord call",
            "Controllers": [
                "Keypad"
            ],
            "SupportedInMultiActions": false,
            "States": [
                {
                    "Image": "imgs/hangup",
                    "ShowTitle": false
                }
            ],
            "UserTitleEnabled": false
        },
        {
            "UUID": "com.nks.calldeck.return",
            "Name": "Back to previous layout",
            "Icon": "imgs/back",
            "Tooltip": "Return from the bundled CallDeck profile",
            "Controllers": [
                "Keypad"
            ],
            "SupportedInMultiActions": false,
            "States": [
                {
                    "ShowTitle": true,
                    "Title": "Back",
                    "TitleAlignment": "bottom",
                    "Image": "imgs/back"
                }
            ],
            "UserTitleEnabled": false
        }
    ],
    "Author": "NKS",
    "Name": "CallDeck",
    "Category": "CallDeck",
    "CategoryIcon": "imgs/answer-action",
    "Description": "Answer, decline and hang up through the local CallDeck Vencord bridge.",
    "UUID": "com.nks.calldeck",
    "Version": "0.1.5.0",
    "SDKVersion": 2,
    "Software": {
        "MinimumVersion": "6.6"
    },
    "Nodejs": {
        "Version": "20"
    },
    "OS": [
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "CodePath": "bin/plugin.cjs",
    "Icon": "imgs/plugin",
    "PropertyInspectorPath": "ui/settings.html",
    "Profiles": [
        {
            "DeviceType": 0,
            "Name": "profiles/CallDeck-Standard",
            "AutoInstall": false,
            "Readonly": false,
            "DontAutoSwitchWhenInstalled": true
        },
        {
            "DeviceType": 1,
            "Name": "profiles/CallDeck-Mini",
            "AutoInstall": false,
            "Readonly": false,
            "DontAutoSwitchWhenInstalled": true
        },
        {
            "DeviceType": 2,
            "Name": "profiles/CallDeck-XL",
            "AutoInstall": false,
            "Readonly": false,
            "DontAutoSwitchWhenInstalled": true
        },
        {
            "DeviceType": 7,
            "Name": "profiles/CallDeck-Plus",
            "AutoInstall": false,
            "Readonly": false,
            "DontAutoSwitchWhenInstalled": true
        },
        {
            "DeviceType": 9,
            "Name": "profiles/CallDeck-Neo",
            "AutoInstall": false,
            "Readonly": false,
            "DontAutoSwitchWhenInstalled": true
        }
    ]
}